firmware/detector/secretos.h
# Compilación
firmware/build/
firmware/test/bin/
node_modules/
# Espacio de trabajo de los agentes
.superpowers/
# Certificado y datos locales del servidor
web/certs/
web/datos/

# Material de diseño histórico: no forma parte de la versión estable (enlaces rotos, nombre antiguo)
