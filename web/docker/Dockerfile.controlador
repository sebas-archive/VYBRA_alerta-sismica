# Controlador de infraestructura: apaga/enciende servidores. Único servicio con acceso al socket de Docker.
# Sin dependencias (solo módulos de Node). Corre con el sistema de archivos de solo lectura (ver docker-compose.yml).
FROM node:22.22-alpine
WORKDIR /app
COPY controlador ./controlador
CMD ["node", "controlador/controlador.js"]
