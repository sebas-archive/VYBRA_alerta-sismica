# Servidor 2: openSUSE Leap (servidor de datos: recolector + API; su base PostgreSQL va en otro contenedor)
FROM node:22-alpine AS deps
WORKDIR /d
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM opensuse/leap:15.6
RUN zypper --non-interactive install --no-recommends nodejs22 && zypper clean --all
WORKDIR /app
COPY package.json ./
COPY --from=deps /d/node_modules ./node_modules
COPY servidor ./servidor
USER 65534
CMD ["node", "servidor/servidor.js"]
