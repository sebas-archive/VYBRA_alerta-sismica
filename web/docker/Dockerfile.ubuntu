# Servidor 3: Ubuntu (servidor de datos: recolector + API; su base PostgreSQL va en otro contenedor)
FROM node:22-alpine AS deps
WORKDIR /d
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends nodejs ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json ./
COPY --from=deps /d/node_modules ./node_modules
COPY servidor ./servidor
USER 65534
CMD ["node", "servidor/servidor.js"]
