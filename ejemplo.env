# Copia este archivo a .env (git ignora .env) y ajústalo. NO pongas aquí contraseñas de producción:
# en producción la clave de las bases va en secretos/db_password.txt (ver docker-compose.prod.yml).

# --- ESP32 reales: dirección de cada nodo (sin barra final). Sin definir, se usan los simulados nodo1..3. ---
#NODO1_URL=http://192.168.1.50
#NODO2_URL=http://192.168.1.51
#NODO3_URL=http://192.168.1.52

# --- Puerto del panel en el equipo ---
#PUERTO_PANEL=8095

# --- HTTPS (Caddy): perfil "https" (docker compose --profile https up -d) ---
# IP o nombre con el que entras al panel y puerto HTTPS:
#HOST_PUBLICO=192.168.80.227
#PUERTO_HTTPS=8443

# --- Solo DESARROLLO: clave de las bases (por defecto "vybra") ---
#DB_PASSWORD=

# --- Retención/archivado (todo desactivado por defecto; ver docs/servidores-de-datos.md) ---
#RETENCION_ACTIVA=si
#RETENCION_MODO=archivar
#RETENCION_MUESTRAS_DIAS=30
#RETENCION_SUCESOS_DIAS=365
#RETENCION_ACCIONES_DIAS=365
